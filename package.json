{
  "name": "prisma",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "assets": "node scripts/process-assets.mjs",
    "check-levels": "esbuild scripts/reach-check.ts --bundle --platform=node --format=esm --outfile=.debug/reach.mjs --log-level=error && node .debug/reach.mjs",
    "test:save": "esbuild src/systems/Save.ts --bundle --platform=node --format=esm --outfile=.debug/save.mjs --log-level=error && node --test tests/save.test.mjs",
    "test:input": "esbuild src/systems/GamepadAxis.ts --bundle --platform=node --format=esm --outfile=.debug/gamepad-axis.mjs --log-level=error && node --test tests/gamepad-axis.test.mjs",
    "test:levels": "esbuild src/levels/extend.ts --bundle --platform=node --format=esm --outfile=.debug/extend.mjs --log-level=error && esbuild src/levels/index.ts --bundle --platform=node --format=esm --outfile=.debug/levels.mjs --log-level=error && node --test tests/levels.test.mjs",
    "shots": "node scripts/shots.mjs",
    "bench:vale": "node scripts/bench-vale.mjs",
    "test:vale-play": "node scripts/play-vale.mjs",
    "art:import": "node scripts/import-terrain-master.mjs",
    "test:terrain-master": "node --test tests/terrain-master.test.mjs",
    "test:lantern-annex": "esbuild src/world/LanternAnnex.ts --bundle --platform=node --format=esm --outfile=.debug/lantern-annex.mjs --log-level=error && node --test tests/lantern-annex.test.mjs",
    "test:decor-placement": "esbuild src/world/DecorPlacement.ts --bundle --platform=node --format=esm --outfile=.debug/decor-placement.mjs --log-level=error && node --test tests/decor-placement.test.mjs",
    "test:camera-director": "esbuild src/world/CameraDirector.ts --bundle --platform=node --format=esm --outfile=.debug/camera-director.mjs --log-level=error && esbuild src/world/CloseCamera.ts --bundle --platform=node --format=esm --outfile=.debug/close-camera.mjs --log-level=error && node --test tests/camera-director.test.mjs",
    "test:environmental-motion": "esbuild src/world/EnvironmentalMotion.ts --bundle --platform=node --format=esm --outfile=.debug/environmental-motion.mjs --log-level=error && node --test tests/environmental-motion.test.mjs",
    "test:material-lighting": "esbuild src/world/MaterialLighting.ts --bundle --platform=node --format=esm --outfile=.debug/material-lighting.mjs --log-level=error && node --test tests/material-lighting.test.mjs",
    "test:pictorial-material": "esbuild src/world/PictorialMaterial.ts --bundle --platform=node --format=esm --outfile=.debug/pictorial-material.mjs --log-level=error && node --test tests/pictorial-material.test.mjs",
    "test:depth-composition": "esbuild src/world/DepthComposition.ts --bundle --platform=node --format=esm --outfile=.debug/depth-composition.mjs --log-level=error && node --test tests/depth-composition.test.mjs",
    "test:platform-profile": "esbuild src/world/PlatformProfile.ts --bundle --platform=node --format=esm --outfile=.debug/platform-profile.mjs --log-level=error && node --test tests/platform-profile.test.mjs",
    "test:organic-contours": "esbuild src/world/OrganicContours.ts --bundle --platform=node --format=esm --outfile=.debug/organic-contours.mjs --log-level=error && node --test tests/organic-contours.test.mjs",
    "test:visual-geometry": "esbuild src/world/VisualGeometry.ts --bundle --platform=node --format=esm --outfile=.debug/visual-geometry.mjs --log-level=error && node --test tests/visual-geometry.test.mjs",
    "test:art-geometry": "esbuild src/levels/ArtGeometry.ts --bundle --platform=node --format=esm --outfile=.debug/art-geometry.mjs --log-level=error && node --test tests/art-geometry.test.mjs",
    "art:packs": "esbuild scripts/export-art-packs.ts --bundle --platform=node --format=esm --packages=external --outfile=.debug/export-art-packs.mjs --log-level=error && node .debug/export-art-packs.mjs",
    "test:prerender": "node --test tests/prerender-islands.test.mjs",
    "test:wardrobe": "esbuild src/world/Wardrobe.ts --bundle --platform=node --format=esm --outfile=.debug/wardrobe.mjs --log-level=error && node --test tests/wardrobe.test.mjs tests/wardrobe-grid.test.mjs",
    "test:cutscenes": "esbuild src/story/cutsceneWorlds.ts --bundle --platform=node --format=esm --outfile=.debug/cutscene-worlds.mjs --log-level=error && node --test tests/cutscene-worlds.test.mjs",
    "test:part2": "esbuild src/world/Part2.ts --bundle --platform=node --format=esm --outfile=.debug/part2.mjs --log-level=error && node --test tests/part2.test.mjs"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "playwright-core": "^1.56.1",
    "sharp": "0.34.2",
    "typescript": "5.8.3",
    "vite": "6.3.5"
  }
}
