{
  "name": "prisma",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "assets": "node scripts/process-assets.mjs",
    "check-levels": "esbuild scripts/reach-check.ts --bundle --platform=node --format=esm --outfile=.debug/reach.mjs --log-level=error && node .debug/reach.mjs",
    "test:save": "esbuild src/systems/Save.ts --bundle --platform=node --format=esm --outfile=.debug/save.mjs --log-level=error && node --test tests/save.test.mjs",
    "test:input": "esbuild src/systems/GamepadAxis.ts --bundle --platform=node --format=esm --outfile=.debug/gamepad-axis.mjs --log-level=error && node --test tests/gamepad-axis.test.mjs"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "sharp": "0.34.2",
    "typescript": "5.8.3",
    "vite": "6.3.5"
  }
}
